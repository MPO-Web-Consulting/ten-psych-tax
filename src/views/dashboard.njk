{% extends "base.njk" %}

{% block title %}Dashboard — 10Psych Tax{% endblock %}

{% block content %}
<div class="toolbar">
    <h1>Dashboard</h1>
    {% if fiscalYears.length %}
    <form method="get" action="/">
        <select name="fiscalYear" onchange="this.form.submit()">
            {% for year in fiscalYears %}
            <option value="{{ year }}" {% if year == selectedYear %}selected{% endif %}>{{ year }}</option>
            {% endfor %}
        </select>
    </form>
    {% endif %}
</div>

{% if not fiscalYears.length %}
<div class="card empty-state">
    <p><strong>Welcome to 10Psych Tax.</strong> Come back here whenever you get paid or spend on the business:</p>
    <ul class="empty-state-list">
        <li>Log paid invoices and categorized expenses as they happen</li>
        <li>See income vs. expenses graphed by fiscal year</li>
        <li>Download a yearly report — Excel summary + receipts — for your accountant</li>
    </ul>
    <p><a href="/invoices/new"><button type="button">Add your first invoice</button></a> or <a href="/expenses/new">add an expense</a> to get started.</p>
</div>
{% else %}
<div class="stat-row">
    <div class="card stat"><span class="stat-label">Income</span><div class="stat-value">${{ totalIncome }}</div></div>
    <div class="card stat"><span class="stat-label">Expenses</span><div class="stat-value">${{ totalExpense }}</div></div>
    <div class="card stat"><span class="stat-label">Net</span><div class="stat-value">${{ net }}</div></div>
</div>

<div class="card">
    <h2>Income vs Expenses by Fiscal Year</h2>
    <canvas id="trendChart" height="110"></canvas>
</div>

<div class="card">
    <h2>Expense Breakdown — {{ selectedYear }}</h2>
    <canvas id="categoryChart" height="110"></canvas>
</div>
{% endif %}
{% endblock %}

{% block scripts %}
{% if fiscalYears.length %}
<script src="/js/chart.umd.min.js"></script>
<script>
    const trendData = {{ trendData | safe }};
    const categoryData = {{ categoryData | safe }};

    new Chart(document.getElementById("trendChart"), {
        type: "bar",
        data: {
            labels: trendData.map((d) => d.fiscalYear),
            datasets: [
                { label: "Income", data: trendData.map((d) => d.incomeCents / 100), backgroundColor: "#0d9488" },
                { label: "Expenses", data: trendData.map((d) => d.expenseCents / 100), backgroundColor: "#dc2626" }
            ]
        },
        options: { responsive: true, scales: { y: { beginAtZero: true } } }
    });

    new Chart(document.getElementById("categoryChart"), {
        type: "doughnut",
        data: {
            labels: categoryData.map((d) => d.category),
            datasets: [{ data: categoryData.map((d) => d.cents / 100), backgroundColor: ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"] }]
        },
        options: { responsive: true }
    });
</script>
{% endif %}
{% endblock %}
